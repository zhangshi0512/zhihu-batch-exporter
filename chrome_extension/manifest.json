{
  "manifest_version": 3,
  "name": "知乎内容批量导出",
  "version": "0.5.0",
  "description": "从知乎采集本人或他人回答、文章、想法、视频与收藏夹，支持官方开放平台全文/评论/创作统计/关注列表与图片本地化 ZIP 导出。",
  "action": {
    "default_title": "知乎内容批量导出"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ]
    }
  ],
  "permissions": [
    "cookies",
    "downloads",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.zhihu.com/*",
    "https://*.zhihu.com/*",
    "https://developer.zhihu.com/*",
    "https://*.zhimg.com/*"
  ]
}
